{
  "name": "sos-editor-cloudflare-worker",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy --config ./wrangler.jsonc --cwd . --no-autoconfig",
    "deploy:dry-run": "wrangler deploy --config ./wrangler.jsonc --cwd . --no-autoconfig --dry-run",
    "dev": "wrangler dev --config ./wrangler.jsonc --cwd . --no-autoconfig",
    "start": "wrangler dev --config ./wrangler.jsonc --cwd . --no-autoconfig",
    "typegen": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply SOS_EDITOR_DB --local",
    "migrate:prod": "wrangler d1 migrations apply SOS_EDITOR_DB --remote",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/bcryptjs": "^2.4.6",
    "wrangler": "^4.126.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/zod-validator": "^0.4.2",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.16",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "zod": "^3.23.8"
  }
}
